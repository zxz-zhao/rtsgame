{
  "name": "xinghuo-rts-server",
  "version": "1.0.0",
  "description": "Xinghuo RTS game server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js",
    "health": "node scripts/health-check.js",
    "migrate:mysql": "node scripts/migrate-json-to-mysql.js",
    "migrate:mysql:dry": "node scripts/migrate-json-to-mysql.js --dry-run",
    "verify:mysql": "node scripts/verify-json-to-mysql.js",
    "start:json": "node -e \"process.env.DB_BACKEND='json'; require('./server.js')\"",
    "pm2:start": "pm2 startOrReload ecosystem.config.cjs --env production --update-env",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --env production --update-env"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.3",
    "uuid": "^9.0.0",
    "ws": "^8.20.0"
  }
}
