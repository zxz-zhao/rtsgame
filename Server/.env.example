NODE_ENV=development
PORT=8080
WS_PORT=8081
JWT_SECRET=replace-with-a-long-random-secret
DB_BACKEND=mysql

# Optional MySQL configuration for production-like runs.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=unityrts
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=unity_rts
MYSQL_TABLE=rts_kv_store

# Comma-separated origins for browser tools/admin panels if enabled.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
