# Copy this file to .env on the server. Never commit the real .env.
NODE_ENV=production
PORT=8080
WS_PORT=8081
JWT_SECRET=replace-with-a-long-random-secret
BUILD_REVISION=local
DB_BACKEND=mysql

# Optional MySQL configuration for production-like runs.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=unityrts
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=unity_rts
MYSQL_TABLE=rts_kv_store
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_CONNECT_RETRIES=10
MYSQL_CONNECT_RETRY_DELAY_MS=3000

# Comma-separated origins for browser tools/admin panels if enabled.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PM2 / graceful restart tuning.
SHUTDOWN_TIMEOUT_MS=10000
PM2_APP_NAME=unity-rts-server
PM2_MAX_MEMORY=512M
PM2_LISTEN_TIMEOUT_MS=60000
