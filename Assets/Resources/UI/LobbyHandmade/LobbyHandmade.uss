    background-color: rgba(68, 63, 39, 0.96);
    border-top-color: rgb(156, 142, 86);
    border-left-color: rgb(122, 112, 73);
    color: rgb(235, 220, 166);
}

.panel-close:active,
.tech-popup-close:active,
.settings-step:active,
.panel-action:active,
.tech-popup-action:active,
.room-map-button:active,
.match-command-button:active,
.room-command-button:active,
.room-row-button:active,
.invite-friend-button:active,
.warehouse-detail-button:active,
.friends-add-submit:active,
.friend-detail-button:active,
.rank-row:active,
.notify-row:active {
    background-color: rgba(21, 22, 17, 0.98);
    border-top-color: rgb(21, 21, 16);
    border-left-color: rgb(27, 27, 20);
    border-right-color: rgb(118, 107, 68);
    border-bottom-color: rgb(145, 130, 77);
    color: rgb(188, 176, 134);
}

.hit {
    position: absolute;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.click-fx {
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
    transition-property: background-color, border-top-width, border-right-width, border-bottom-width, border-left-width, border-top-color, border-right-color, border-bottom-color, border-left-color, scale;
    transition-duration: 70ms;
    transition-timing-function: ease-out;
}

.click-fx:hover {
    background-color: rgba(172, 160, 104, 0.075);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 2px;
    border-left-width: 1px;
    border-top-color: rgba(151, 142, 96, 0.50);
    border-right-color: rgba(38, 39, 30, 0.62);
    border-bottom-color: rgba(17, 18, 14, 0.75);
    border-left-color: rgba(116, 109, 78, 0.48);
}

.click-fx:active {
    background-color: rgba(0, 0, 0, 0.34);
    border-top-width: 3px;
    border-right-width: 2px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-top-color: rgba(10, 11, 9, 0.88);
    border-right-color: rgba(108, 102, 70, 0.54);
    border-bottom-color: rgba(132, 120, 76, 0.62);
    border-left-color: rgba(11, 12, 9, 0.82);
    scale: 0.992 0.992;
}

.hit-settings:hover,
.hit-notify:hover,
.hit-goldPlus:hover,
.hit-gemPlus:hover,
.hit-techGear:hover {
    background-color: rgba(214, 199, 133, 0.10);
}

.hit-settings:active,
.hit-notify:active,
.hit-goldPlus:active,
.hit-gemPlus:active,
.hit-techGear:active {
    background-color: rgba(0, 0, 0, 0.42);
    scale: 0.975 0.975;
}

.hit-quick:hover,
.hit-custom:hover,
.hit-global:hover,
.hit-shop:hover,
.hit-warehouse:hover,
.hit-campaign:hover,
.hit-rank:hover,
.hit-mail:hover {
    background-color: rgba(177, 166, 108, 0.055);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hit-quick:active,
.hit-custom:active,
.hit-global:active,
.hit-shop:active,
.hit-warehouse:active,
.hit-campaign:active,
.hit-rank:active,
.hit-mail:active {
    background-color: rgba(0, 0, 0, 0.30);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    scale: 0.996 0.996;
}

.debug-hit {
    background-color: rgba(0, 255, 64, 0.16);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(0, 255, 64, 0.65);
    border-right-color: rgba(0, 255, 64, 0.65);
    border-bottom-color: rgba(0, 255, 64, 0.65);
    border-left-color: rgba(0, 255, 64, 0.65);
}

