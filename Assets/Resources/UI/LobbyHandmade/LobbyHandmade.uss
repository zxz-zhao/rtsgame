.lobby-artboard {
    position: absolute;
    overflow: hidden;
}

.lobby-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.dynamic-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.visual-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
}

.static-art {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.top-rail {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 12.5598%;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.top-slot,
.profile-slot,
.portrait-ring,
.settings-icon,
.notify-icon,
.gold-icon,
.gem-icon,
.gold-plus-icon,
.gem-plus-icon {
