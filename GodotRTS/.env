NODE_ENV=production
BIND_HOST=0.0.0.0
PORT=8080
WS_PORT=8081
JWT_SECRET=replace-with-a-long-random-secret
BUILD_REVISION=local
AUTH_TOKEN_BYTES=32
SESSION_TTL_SEC=604800
BCRYPT_COST=10

# Logging and watchdog
LOG_DIR=logs
SERVER_LOG_FILE=logs/server.log
GUARDIAN_LOG_FILE=logs/guardian.log
ALERT_LOG_FILE=logs/alerts.log
LOG_ECHO_STDERR=true
LOG_MAX_QUEUE_SIZE=4096
LOG_ROTATE_BYTES=8388608
ALERT_COMMAND=
GUARDIAN_RESTART_DELAY_MS=2000
GUARDIAN_CRASH_WINDOW_SEC=120
GUARDIAN_MAX_RESTARTS_IN_WINDOW=8
GUARDIAN_COOLDOWN_MS=30000
GUARDIAN_RESTART_ON_ZERO_EXIT=false

# Disable external DBs for local test run
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=unityrts
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=unity_rts
MYSQL_TABLE=rts_kv_store
MYSQL_CLIENT_LIBRARY=

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=unity_rts
STRICT_STORAGE_BACKENDS=false

# Internal callback/admin secret
ADMIN_API_SECRET=replace-with-a-long-random-internal-secret

# Runtime directories
DATA_DIR=data
BACKUP_DIR=backups
